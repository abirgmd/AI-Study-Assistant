# Copiez ce fichier vers ai-service/.env (ignoré par Git) et adaptez les valeurs.

# Jeton partagé avec PHP (identique à 'token' dans config/ai.php), 32 caractères minimum.
# Générez-le avec : python -c "import secrets; print(secrets.token_hex(32))"
AI_INTERNAL_TOKEN=

# --- Socle partagé (modules 2, 3 et 5) --------------------------------------
# sentence-transformers : modèle du cours (télécharge ~470 Mo au premier lancement)
# hashing               : solution hors ligne, sans téléchargement (moins précise)
AI_EMBEDDING_BACKEND=sentence-transformers
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_CHUNK_SIZE=800
AI_CHUNK_OVERLAP=150

# --- Module 3 : RAG ----------------------------------------------------------
AI_RAG_TOP_K=3
# Seuil d'abstention : mesuré à 0.15 pour "hashing". Pour sentence-transformers,
# lancez scripts/evaluate_rag.py --embedding sentence-transformers et reportez ici
# la valeur conseillée (rubrique "seuil" de reports/rag/sentence-transformers/resume.json).
AI_RAG_MIN_SCORE=0.15
AI_RAG_PROMPT_VERSION=v3
AI_CACHE_SIZE=256

# Génération : extractive (aucun modèle), flan-t5 (modèle local du TP) ou api
AI_LLM_BACKEND=ollama
AI_LOCAL_MODEL=google/flan-t5-base
AI_LOCAL_QUANTIZE=false
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=llama3:8b
AI_OLLAMA_TIMEOUT=120
AI_MAX_NEW_TOKENS=200
AI_TEMPERATURE=0.2

# Uniquement si AI_LLM_BACKEND=api. Attention : les extraits de cours sont alors
# envoyés au fournisseur externe (voir la section éthique du rapport).
AI_API_PROVIDER=anthropic
AI_API_MODEL=claude-haiku-5-5
AI_API_KEY=
AI_API_TIMEOUT=30

# --- Module 5 : classification ------------------------------------------------
# Laisser vide : seuil choisi à l'entraînement (models/classifier_meta.json).
# AI_CLASSIFIER_MIN_CONFIDENCE=0.25
